"""Investigates an openQA job failure using an LLM."""

import json
import logging
import os
import sys
from pathlib import Path
from typing import Annotated, Any

import httpx
import typer

sys.path.insert(0, str(Path(__file__).resolve().parent))

from investigate_common import (
    DEFAULT_HTTP_TIMEOUT as DEFAULT_OPENQA_TIMEOUT,
)
from investigate_common import (
    DEFAULT_INVESTIGATION_TIMEOUT,
    RetryTransport,
    fetch_json,
    fetch_text,
    setup_logging,
)
from investigate_common import (
    parse_job_url_and_base as parse_job_url,
)
from investigate_common import (
    post_comment as common_post_comment,
)

USER_AGENT = "openqa-llm-investigate (https://github.com/os-autoinst/os-autoinst-scripts)"

log = logging.getLogger(__name__)

app = typer.Typer(add_completion=False)


def post_comment(base_url: str, job_id: str, comment: str) -> None:
    common_post_comment(base_url, job_id, comment, user_agent=USER_AGENT)


def _shares_failed_modules(other_job: dict[str, Any], target_modules: set[str]) -> bool:
    """Check if the given job has failures in any of the target modules."""
    other_failed = (m.get("name") for m in other_job.get("modules", []) if m.get("result") == "failed")
    return bool(target_modules.intersection(other_failed))


def _call_llm_api(
    client: httpx.Client,
    llm_url: str,
    llm_model: str,
    llm_token: str | None,
    timeout: int,
    prompt: str,
) -> str:
    req = {
        "model": llm_model,
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0.3,
    }
    headers = {"Authorization": f"Bearer {llm_token}"} if llm_token else {}
    try:
        res = client.post(llm_url, json=req, headers=headers, timeout=timeout)
        res.raise_for_status()
        res_json = res.json()
        return res_json["choices"][0]["message"]["content"]
    except httpx.ConnectError:
        log.error(
            "Could not connect to LLM server at %s. Please check if the server is running or the LLM_API_URL environment variable is correct.",
            llm_url,
        )
        sys.exit(1)
    except httpx.HTTPStatusError as e:
        log.error("LLM API %s (%s) status %d: %s", llm_url, llm_model, e.response.status_code, e.response.text)
        sys.exit(1)
    except Exception as e:
        log.error("LLM API %s (%s) failed: %s", llm_url, llm_model, e)
        sys.exit(1)


def _perform_investigation(
    client: httpx.Client,
    base_url: str,
    job_id: str,
    force: bool,
    dry: bool,
    llm_url: str,
    llm_model: str,
    timeout: int,
    llm_token: str | None,
    log_lines: int,
    history_limit: int,
    build_failure_threshold: int,
    prompt_template_file: str | None,
    investigation_timeout: float = DEFAULT_INVESTIGATION_TIMEOUT,
) -> None:
    # Check for existing LLM investigation comments
    comments = fetch_json(client, f"{base_url}/api/v1/jobs/{job_id}/comments", default=[])
    if not force and any(c.get("text", "").startswith("**LLM Investigation summary:**") for c in comments):
        log.info("Job %s already has an LLM investigation summary, skipping.", job_id)
        sys.exit(0)

    # Fetch job details
    job_data = fetch_json(client, f"{base_url}/api/v1/jobs/{job_id}/details")
    if not job_data or "job" not in job_data:
        # Fallback for openQA versions/configurations where /details might fail
        job_data = fetch_json(client, f"{base_url}/api/v1/jobs/{job_id}")
    if not job_data or "job" not in job_data:
        log.error("Could not retrieve job data for job %s from %s", job_id, base_url)
        sys.exit(1)
    job = job_data["job"]

    if not force and job.get("result") in {"passed", "softfailed"}:
        log.info("Job %s %s, skipping investigation.", job_id, job.get("result"))
        sys.exit(0)

    failed_modules = [m.get("name", "unknown") for m in job.get("testresults", []) if m.get("result") == "failed"]

    log_text = fetch_text(client, f"{base_url}/tests/{job_id}/file/autoinst-log.txt", max_lines=log_lines)
    investigation = fetch_json(client, f"{base_url}/tests/{job_id}/investigation_ajax", timeout=investigation_timeout)

    test_name = job.get("test", "unknown")
    settings = job.get("settings", {})
    build, distri, version, arch, flavor = (
        settings.get(k, "unknown") for k in ("BUILD", "DISTRI", "VERSION", "ARCH", "FLAVOR")
    )

    # Search for similar failures in same build (across all tests)
    build_params = {"build": build, "distri": distri, "version": version, "result": "failed"}
    build_history_data = fetch_json(client, f"{base_url}/api/v1/jobs", params=build_params)
    build_failed_jobs = build_history_data.get("jobs", [])
    build_failures = len(build_failed_jobs)

    failed_modules_set = set(failed_modules)

    def is_similar(j: dict[str, Any]) -> bool:
        return str(j.get("id")) != str(job_id) and _shares_failed_modules(j, failed_modules_set)

    same_module_failures = sum(1 for j in build_failed_jobs if is_similar(j)) if failed_modules else 0

    # Search for consecutive failures of the same test (across all builds)
    test_params = {
        "test": test_name,
        "distri": distri,
        "version": version,
        "arch": arch,
        "flavor": flavor,
        "limit": history_limit,
    }
    test_history_data = fetch_json(client, f"{base_url}/api/v1/jobs", params=test_params)
    test_jobs = sorted(test_history_data.get("jobs", []), key=lambda x: x["id"], reverse=True)

    target_id_int = int(job_id)
    valid_results = {"passed", "softfailed", "failed"}
    found_target = any(j["id"] == target_id_int for j in test_jobs)
    relevant_jobs = [
        j
        for j in test_jobs
        if j["id"] <= target_id_int and j.get("state") == "done" and j.get("result") in valid_results
    ]
    consecutive_failures = next(
        (i for i, j in enumerate(relevant_jobs) if j.get("result") != "failed"), len(relevant_jobs)
    )

    if not found_target:
        log.warning(
            "Job %s not found in recent history (limit %s). Streak count may be inaccurate.",
            job_id,
            test_params["limit"],
        )

    hint = ""
    if build_failures > build_failure_threshold:
        hint = f"\n(Note: {build_failures} failures across this build strongly implies a backend infrastructure outage or a widespread environment issue rather than a specific product bug.)"

    prompt_extension = settings.get("LLM_PROMPT_EXTENSION")
    prompt_extension_text = (
        f"\n\nTest-specific instructions from openQA variables:\n{prompt_extension}\n" if prompt_extension else ""
    )

    default_prompt_template = """You are analyzing an openQA test run failure.
Job details:
- Test: {test_name}
- Failed module(s): {failed_modules}
- Group: {group}
- Build: {build}
- Distri: {distri}
- Version: {version}
- Arch: {arch}
- Flavor: {flavor}
- Result: {result}
- Total failed jobs in this build (across all tests): {build_failures}{hint}
- Other jobs in this build failing in the exact same module(s): {same_module_failures}
- Consecutive recent failures for this specific test (same name, arch, flavor): {consecutive_failures}

Investigation info (diff to last good):
{investigation_info}

Log tail (last {log_lines} lines):
{log_text}{prompt_extension_text}

Provide exactly 3 sentences answering:
1. Is it a new or existing issue? Is it likely a product regression, test regression, or infrastructure problem?
2. Does the same issue appear in other tests in the same build, and did it appear in the history of the same build?
3. Should 'openqa-investigate' be triggered to schedule further bisect tests? Start your 3rd sentence EXACTLY with "BISECT: YES" or "BISECT: NO" followed by the reason.
   - If other jobs in the same build are failing in the exact same module, this is a widespread issue. You MUST answer BISECT: NO to prevent redundant and costly bisections, as another job has likely already triggered it.
   - If the failure is isolated to ONLY this job in the current build, AND the log contains an explicit product error or test assertion failure (e.g., 'actual size fits X: fail', 'command not found', 'segmentation fault'), it strongly points to a new regression. In this isolated case, you MUST answer BISECT: YES.
"""

    if prompt_template_file:
        try:
            prompt_template = Path(prompt_template_file).read_text(encoding="utf-8")
        except OSError as e:
            log.error("Could not read prompt template file %s: %s", prompt_template_file, e)
            sys.exit(1)
    else:
        prompt_template = default_prompt_template

    prompt = prompt_template.format(
        test_name=test_name,
        failed_modules=", ".join(failed_modules) if failed_modules else "unknown",
        group=job.get("group", "unknown"),
        build=build,
        distri=distri,
        version=version,
        arch=arch,
        flavor=flavor,
        result=job.get("result", "unknown"),
        build_failures=build_failures,
        hint=hint,
        same_module_failures=same_module_failures,
        consecutive_failures=consecutive_failures,
        investigation_info=json.dumps(investigation.get("diff_to_last_good", "None available")),
        log_lines=log_lines,
        log_text=log_text,
        prompt_extension_text=prompt_extension_text,
    )

    llm_response = _call_llm_api(client, llm_url, llm_model, llm_token, timeout, prompt)

    # Print the job URL to stdout ONLY if BISECT: YES is recommended
    # This makes the script act as a gatekeeper, similar to `openqa-label-known-issues`
    if "BISECT: YES" in llm_response.upper():
        print(f"{base_url}/tests/{job_id}")

    if dry:
        print(f"**LLM Investigation summary:**\n\n{llm_response}")
    else:
        post_comment(base_url, job_id, f"**LLM Investigation summary:**\n\n{llm_response}")


@app.command()
def investigate(
    job_url: str = typer.Argument(..., help="The openQA test URL or job ID for which to trigger LLM investigation"),
    verbose: Annotated[int, typer.Option("--verbose", "-v", count=True, help="Increase verbosity")] = 0,
    quiet: Annotated[bool, typer.Option("--quiet", "-q", help="Quiet mode")] = False,  # ruff: ignore[boolean-default-value-positional-argument]
    dry: Annotated[  # ruff: ignore[boolean-default-value-positional-argument]
        bool, typer.Option("--dry", help="Dry run mode: output summary instead of posting a comment")
    ] = False,
    force: Annotated[  # ruff: ignore[boolean-default-value-positional-argument]
        bool,
        typer.Option(
            "--force",
            "-f",
            help="Force another analysis even if an LLM comment already exists or if the job passed/softfailed",
        ),
    ] = False,
    timeout: Annotated[int, typer.Option("--timeout", help="Timeout for LLM API requests in seconds")] = int(
        os.environ.get("LLM_TIMEOUT", "600")
    ),
    retries: Annotated[int, typer.Option("--retries", help="Number of retries on retry-worthy HTTP responses")] = int(
        os.environ.get("LLM_RETRIES", "7")
    ),
    llm_url: Annotated[
        str, typer.Option("--llm-url", envvar="LLM_API_URL", help="URL for the LLM API endpoint")
    ] = os.environ.get("LLM_API_URL", "http://localhost:8080/v1/chat/completions"),
    llm_model: Annotated[
        str, typer.Option("--llm-model", envvar="LLM_MODEL", help="The LLM model to use")
    ] = os.environ.get("LLM_MODEL", "gemma-4-26B-A4B-it"),
    llm_token: Annotated[
        str | None, typer.Option("--llm-token", envvar="LLM_API_TOKEN", help="API token for authentication")
    ] = os.environ.get("LLM_API_TOKEN"),
    log_lines: Annotated[
        int, typer.Option("--log-lines", envvar="LLM_LOG_LINES", help="Number of log lines to fetch")
    ] = int(os.environ.get("LLM_LOG_LINES", "200")),
    history_limit: Annotated[
        int, typer.Option("--history-limit", envvar="LLM_HISTORY_LIMIT", help="Limit for consecutive failure lookup")
    ] = int(os.environ.get("LLM_HISTORY_LIMIT", "100")),
    build_failure_threshold: Annotated[
        int,
        typer.Option(
            "--build-failure-threshold",
            envvar="LLM_BUILD_FAILURE_THRESHOLD",
            help="Threshold for infrastructure outage hint",
        ),
    ] = int(os.environ.get("LLM_BUILD_FAILURE_THRESHOLD", "20")),
    prompt_template_file: Annotated[
        str | None,
        typer.Option(
            "--prompt-template-file",
            envvar="LLM_PROMPT_TEMPLATE_FILE",
            help="File containing the prompt template to use",
        ),
    ] = os.environ.get("LLM_PROMPT_TEMPLATE_FILE"),
    openqa_timeout: Annotated[
        float,
        typer.Option(
            "--openqa-timeout",
            envvar=["OPENQA_HTTP_TIMEOUT_S"],
            help="Timeout for openQA HTTP requests in seconds",
        ),
    ] = float(os.environ.get("OPENQA_HTTP_TIMEOUT_S", str(DEFAULT_OPENQA_TIMEOUT))),
    investigation_timeout: Annotated[
        float,
        typer.Option(
            "--investigation-timeout",
            envvar=["OPENQA_INVESTIGATION_TIMEOUT_S"],
            help="Timeout for investigation_ajax HTTP requests in seconds",
        ),
    ] = float(os.environ.get("OPENQA_INVESTIGATION_TIMEOUT_S", str(DEFAULT_INVESTIGATION_TIMEOUT))),
) -> None:
    setup_logging(verbose, quiet)
    base_url, job_id = parse_job_url(job_url)

    if not job_id.isdigit():
        log.error("Invalid job ID: %s", job_id)
        sys.exit(1)

    transport = RetryTransport(retries=retries)
    with httpx.Client(transport=transport, headers={"User-Agent": USER_AGENT}, timeout=openqa_timeout) as client:
        _perform_investigation(
            client,
            base_url,
            job_id,
            force,
            dry,
            llm_url,
            llm_model,
            timeout,
            llm_token,
            log_lines,
            history_limit,
            build_failure_threshold,
            prompt_template_file,
            investigation_timeout=investigation_timeout,
        )


if __name__ == "__main__":
    app()
